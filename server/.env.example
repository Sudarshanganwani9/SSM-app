# ==============================
# SSM Server Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# ==============================

# Server
PORT=5000
NODE_ENV=development

# Client
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas connection string or local mongodb://127.0.0.1:27017/ssm)
MONGODB_URI=mongodb://127.0.0.1:27017/ssm

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_DAYS=7

# Initial Admin Seed (used only by `npm run seed:admin`)
SEED_ADMIN_EMAIL=sidkushwah9@gmail.com
SEED_ADMIN_PASSWORD=Sid@123@123
SEED_ADMIN_NAME=Sid Kushwah

# SMTP (optional - if not set, the app falls back to a dev-safe console mailer
# and forgot-password tokens are logged to the server console / returned via
# a dev-only endpoint response instead of emailed)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="SSM HR" <no-reply@ssm.local>

# Application timezone (business logic timezone, not server OS timezone)
APP_TIMEZONE=Asia/Kolkata

# Uploads
MAX_UPLOAD_MB=5
